# ─── API Gateway Endpoints ─────────────────────────────
AWS_API_GATEWAY_URL=https://your-api-gateway-endpoint.execute-api.region.amazonaws.com/dev
API_BASE_URL=https://your-api-gateway-endpoint.execute-api.region.amazonaws.com/dev

# ─── AWS Configuration ──────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=your_aws_account_id

# ─── Cognito ────────────────────────────────────────────
COGNITO_USER_POOL_ID=region_poolid
COGNITO_CLIENT_ID=your_cognito_client_id
COGNITO_IDENTITY_POOL_ID=region:your_identity_pool_id

# ─── DynamoDB Tables ───────────────────────────────────
ALERTS_TABLE=shadowtrace-alerts
LOCATIONS_TABLE=shadowtrace-locations
TRIPS_TABLE=shadowtrace-trips
DEVICE_TOKENS_TABLE=shadowtrace-device-tokens
CONTACTS_TABLE=shadowtrace-contacts

# ─── SNS ────────────────────────────────────────────────
SNS_ALERTS_TOPIC=arn:aws:sns:region:account:topic-name

# ─── Amazon Location Service ───────────────────────────
ALS_TRACKER_NAME=shadowtrace-tracker
ALS_ROUTE_CALC_NAME=shadowtrace-route-calc
ALS_GEOFENCE_COLLECTION=shadowtrace-routes
ALS_PLACE_INDEX=shadowtrace-place-index

# ─── S3 ─────────────────────────────────────────────────
AUDIO_BUCKET=shadowtrace-audio-bucket

# ─── External APIs ──────────────────────────────────────
OWM_KEY=your_openweathermap_api_key
HERE_API_KEY=your_here_maps_api_key
FIREBASE_API_KEY=your_firebase_api_key

# ─── Application Configuration ──────────────────────────
LOCATION_POLL_INTERVAL_SECONDS=10
DEAD_ZONE_THRESHOLD_SECONDS=300
GEOFENCE_BUFFER_METERS=200
NODE_ENV=production


