# Backend Environment Variables

# AWS Region
AWS_REGION=ap-south-1
AWS_ACCOUNT_ID=YOUR_ACCOUNT_ID

# Cognito
COGNITO_USER_POOL_ID=ap-south-1_XXXXXXX
COGNITO_CLIENT_ID=YOUR_CLIENT_ID
COGNITO_IDENTITY_POOL_ID=ap-south-1:XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX

# DynamoDB Tables
ALERTS_TABLE=shadowtrace-alerts
LOCATIONS_TABLE=shadowtrace-locations
TRIPS_TABLE=shadowtrace-trips
DEVICE_TOKENS_TABLE=shadowtrace-device-tokens
CONTACTS_TABLE=shadowtrace-contacts

# SNS
SNS_TOPIC_ARN=arn:aws:sns:ap-south-1:YOUR_ACCOUNT_ID:shadowtrace-sns

# Step Functions
EMERGENCY_WORKFLOW_ARN=arn:aws:states:ap-south-1:YOUR_ACCOUNT_ID:stateMachine:ShadowTraceEmergencyWorkflow

# OpenWeather Map
OWM_KEY=YOUR_OPENWEATHER_MAP_API_KEY

# Location Service
TRACKER_NAME=shadowtrace-tracker
ROUTE_CALC_NAME=shadowtrace-route-calc
GEOFENCE_COLLECTION=shadowtrace-routes
PLACE_INDEX=shadowtrace-place-index

# API Gateway
API_BASE_URL=https://YOUR_API_ID.execute-api.ap-south-1.amazonaws.com/dev

# Node.js/Lambda Runtime
NODE_ENV=production
